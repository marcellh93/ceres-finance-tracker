{
  "Vite": {
    "Base": "dist"
  },
  "Email": {
    "FileSink": {
      "Directory": ".e2e/emails"
    }
  },
  "RateLimits": {
    "LoginByIpPermitLimit": 1000,
    "CsrfByIpPermitLimit": 600,
    "EmailByIpPermitLimit": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
