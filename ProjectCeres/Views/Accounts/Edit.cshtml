@model AccountEditViewModel
@{ ViewData["Title"] = "Edit Account"; }

<h1>Edit Account</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="OpeningBalance"></label>
        <input type="text" id="OpeningBalance" name="OpeningBalance"
               value="@NumberFormatHelper.FormatInputValue(Model.OpeningBalance, ViewData["NumberFormat"] as string)"
               class="form-control" />
        <span asp-validation-for="OpeningBalance" class="field-error"></span>
        <small class="form-hint">The starting balance when you began tracking this account. This is not a transaction — it is excluded from income and expense reports.</small>
    </div>

    <div class="form-group">
        <label asp-for="OpeningBalanceDate"></label>
        <input asp-for="OpeningBalanceDate" class="form-control" />
        <span asp-validation-for="OpeningBalanceDate" class="field-error"></span>
        <small class="form-hint">
            Transactions cannot be recorded before this date. If you move it forward, any existing
            transactions dated before the new date will no longer be reachable for editing — they
            will still exist but new transactions cannot be added before them. Move it backward
            freely to allow recording earlier transactions.
        </small>
    </div>

    <small class="form-hint">Account type and currency cannot be changed after creation.</small>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
