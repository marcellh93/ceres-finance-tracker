@model AccountCreateViewModel
@{ ViewData["Title"] = "New Account"; }

<h1>New Account</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="AccountTypeId"></label>
        <select asp-for="AccountTypeId" asp-items="ViewBag.AccountTypes" class="form-control">
            <option value="">— Select type —</option>
        </select>
        <span asp-validation-for="AccountTypeId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CurrencyId"></label>
        <select asp-for="CurrencyId" asp-items="ViewBag.Currencies" class="form-control">
            <option value="">— Select currency —</option>
        </select>
        <span asp-validation-for="CurrencyId" class="field-error"></span>
    </div>

    <div class="form-group" id="liability-fields" style="display:none;">
        <label asp-for="LiabilityRepaymentType"></label>
        <select asp-for="LiabilityRepaymentType" class="form-control" id="LiabilityRepaymentType">
            <option value="">— None —</option>
            <option value="FullMonthly">Full Monthly (pay in full each month)</option>
            <option value="Amortising">Amortising (fixed monthly payment + interest)</option>
        </select>
        <small class="form-hint">
            <strong>Full Monthly</strong> — pay the full balance each month; no interest accrues.
            <strong>Amortising</strong> — fixed monthly payment with interest; use for loans and mortgages.
        </small>
        <span asp-validation-for="LiabilityRepaymentType" class="field-error"></span>
    </div>

    <div class="form-group" id="interest-rate-field" style="display:none;">
        <label asp-for="InterestRate"></label>
        <input type="text" id="InterestRate" name="InterestRate"
               value="@NumberFormatHelper.FormatRatioInputValue(Model.InterestRate, ViewData["NumberFormat"] as string)"
               class="form-control" placeholder="e.g. 0.035 for 3.5%" />
        <small>Annual interest rate as a decimal. Required for Amortising accounts.</small>
        <span asp-validation-for="InterestRate" class="field-error"></span>
    </div>

    <div class="form-group" id="exclude-from-spendable-field" style="display:none;">
        <label class="toggle-label">
            <span class="toggle-text">Exclude from spendable balance</span>
            <span class="relative inline-block w-11 h-6">
                <input asp-for="ExcludeFromSpendable" type="checkbox"
                       class="peer absolute opacity-0 w-0 h-0" />
                <span class="absolute inset-0 rounded-full bg-gray-200 transition-colors duration-200
                             peer-checked:bg-[#248e38] peer-focus:ring-2 peer-focus:ring-[#248e38]
                             peer-focus:ring-offset-1 cursor-pointer"></span>
                <span class="absolute top-0.5 left-0.5 h-5 w-5 rounded-full bg-white shadow
                             transition-transform duration-200 peer-checked:translate-x-5 cursor-pointer"></span>
            </span>
        </label>
        <small class="form-hint">Excluded accounts don't count toward your spendable balance but still appear in net worth.</small>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="OpeningBalance"></label>
        <input type="text" id="OpeningBalance" name="OpeningBalance"
               value="@NumberFormatHelper.FormatInputValue(Model.OpeningBalance, ViewData["NumberFormat"] as string)"
               class="form-control" />
        <small>Leave at 0 to start with no balance. A negative value records a liability opening balance.</small>
        <span asp-validation-for="OpeningBalance" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="OpeningBalanceDate"></label>
        <input asp-for="OpeningBalanceDate" class="form-control" />
        <small>The date from which this account starts being tracked. Transactions cannot be recorded before this date. Defaults to today.</small>
        <span asp-validation-for="OpeningBalanceDate" class="field-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create Account</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            var accountTypeSelect          = document.getElementById('AccountTypeId');
            var repaymentTypeSelect        = document.getElementById('LiabilityRepaymentType');
            var liabilityFields            = document.getElementById('liability-fields');
            var interestRateField          = document.getElementById('interest-rate-field');
            var excludeFromSpendableField  = document.getElementById('exclude-from-spendable-field');

            // AccountType seed: 1 = Asset, 2 = Liability
            function isLiability() { return accountTypeSelect.value === '2'; }
            function isAmortising() { return repaymentTypeSelect.value === 'Amortising'; }

            function updateVisibility() {
                liabilityFields.style.display              = isLiability() ? '' : 'none';
                interestRateField.style.display            = isLiability() && isAmortising() ? '' : 'none';
                excludeFromSpendableField.style.display    = accountTypeSelect.value === '1' ? '' : 'none';
            }

            accountTypeSelect.addEventListener('change', updateVisibility);
            repaymentTypeSelect.addEventListener('change', updateVisibility);
            updateVisibility();
        })();
    </script>
}
