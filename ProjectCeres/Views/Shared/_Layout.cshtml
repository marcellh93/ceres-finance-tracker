@inject ProjectCeres.Services.IRecurringTransactionService RecurringTransactionService
@{
    var upcomingCount = (await RecurringTransactionService.GetUpcomingAsync(withinDays: 5)).Count();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personal finance tracker for individuals and freelancers. Track assets, liabilities, net worth, income, expenses, and goal budgets." />
    <meta name="theme-color" content="#007c7c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"] - Project Ceres</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div id="navbar-root"
     data-upcoming-count="@upcomingCount"></div>
    </header>

    <main>
        <div class="page-content">
            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="alert alert-success">@success</div>
            }
            @if (TempData["ErrorMessage"] is string error)
            {
                <div class="alert alert-error">@error</div>
            }

            @RenderBody()
        </div>
    </main>

    <footer>
        &copy; 2026 Project Ceres
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script type="module" vite-src="~/src/main.tsx"></script>
</body>
</html>
