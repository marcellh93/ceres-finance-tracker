@model IEnumerable<TransactionListItemViewModel>
@{ ViewData["Title"] = "Transactions"; }

<div class="page-header">
    <h1>Transactions</h1>
    <a asp-action="Create" class="btn btn-primary inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Transaction
    </a>
</div>

<form asp-action="Index" method="get" class="filter-bar">
    <select name="accountId" class="form-control">
        <option value="">All Accounts</option>
        @foreach (var item in (SelectList)ViewBag.Accounts)
        {
            <option value="@item.Value" selected="@(item.Value == ViewBag.AccountId?.ToString())">@item.Text</option>
        }
    </select>
    <input type="date" name="from" value="@ViewBag.From" class="form-control" />
    <input type="date" name="to" value="@ViewBag.To" class="form-control" />
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a asp-action="Index" class="btn btn-link">Clear</a>
</form>

@if (ViewBag.From is not null && ViewBag.To is not null)
{
    <form asp-action="BulkMarkCleared" method="post" class="bulk-action-bar"
          onsubmit="return confirm('Mark all transactions in this date range as cleared?')">
        @Html.AntiForgeryToken()
        <input type="hidden" name="from" value="@ViewBag.From" />
        <input type="hidden" name="to" value="@ViewBag.To" />
        <input type="hidden" name="accountId" value="@ViewBag.AccountId" />
        <button type="submit" class="btn btn-secondary inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Mark all cleared
        </button>
    </form>
}

@if (!Model.Any())
{
    <p class="empty-state">No transactions found.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Account</th>
                <th>Details</th>
                <th>Description</th>
                <th>Type</th>
                <th class="text-right">Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Date.ToString("dd/MM/yyyy")</td>

                    @if (item.TransactionType == "LiabilityPayment")
                    {
                        <td>@item.AssetAccountName</td>
                        <td>→ @item.LiabilityAccountName</td>
                        <td>@(item.Description ?? "—")</td>
                        <td><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-orange-100 text-orange-800 whitespace-nowrap">Liability Payment</span></td>
                        <td class="amount-neutral text-right">
                            @NumberFormatHelper.FormatAmount(item.Amount, ViewData["NumberFormat"] as string)
                        </td>
                    }
                    else
                    {
                        <td>@item.AccountName</td>
                        <td>@item.CategoryName</td>
                        <td>@(item.Description ?? "—")</td>
                        <td>@item.CategoryTypeName</td>
                        <td class="@(item.CategoryTypeName == "Income" ? "amount-income" : "amount-expense") whitespace-nowrap text-right">
                            @item.CurrencySymbol @NumberFormatHelper.FormatAmount(item.Amount, ViewData["NumberFormat"] as string)
                        </td>
                    }

                    <td>
                        <div data-react="cleared-badge"
                             data-id="@item.Id"
                             data-movement-type="transaction"
                             data-cleared="@item.IsCleared.ToString().ToLower()"
                             data-needs-review="@item.NeedsReview.ToString().ToLower()"></div>
                    </td>

                    <td class="actions">
                        <div class="flex gap-2 items-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="pagination">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-accountId="@ViewBag.AccountId"
                   asp-route-from="@ViewBag.From"
                   asp-route-to="@ViewBag.To"
                   class="@(i == (int)ViewBag.Page ? "page-link active" : "page-link")">@i</a>
            }
        </div>
    }
}
