@model IEnumerable<Transaction>
@{ ViewData["Title"] = "Transactions"; }

<div class="page-header">
    <h1>Transactions</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Transaction</a>
</div>

<form asp-action="Index" method="get" class="filter-bar">
    <select name="accountId" class="form-control">
        <option value="">All Accounts</option>
        @foreach (var item in (SelectList)ViewBag.Accounts)
        {
            <option value="@item.Value" selected="@(item.Value == ViewBag.AccountId?.ToString())">@item.Text</option>
        }
    </select>
    <input type="date" name="from" value="@ViewBag.From" class="form-control" />
    <input type="date" name="to" value="@ViewBag.To" class="form-control" />
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a asp-action="Index" class="btn btn-link">Clear</a>
</form>

@if (!Model.Any())
{
    <p class="empty-state">No transactions found.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Account</th>
                <th>Category</th>
                <th>Description</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Date.ToString("dd/MM/yyyy")</td>
                    <td>@t.Account.Name</td>
                    <td>@t.Category.Name</td>
                    <td>@(t.Description ?? "—")</td>
                    <td>@t.Category.CategoryType.Name</td>
                    <td class="@(t.Category.CategoryType.Name == "Income" ? "amount-income" : "amount-expense")">
                        @NumberFormatHelper.FormatAmount(t.Amount, ViewData["NumberFormat"] as string)
                    </td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                        <a asp-action="Delete" asp-route-id="@t.Id" class="link-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="pagination">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-accountId="@ViewBag.AccountId"
                   asp-route-from="@ViewBag.From"
                   asp-route-to="@ViewBag.To"
                   class="@(i == (int)ViewBag.Page ? "page-link active" : "page-link")">@i</a>
            }
        </div>
    }
}
