@model TransactionCreateViewModel
@{ ViewData["Title"] = "New Transaction"; }

<h1>New Transaction</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="Date"></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="AccountId"></label>
        <select asp-for="AccountId" asp-items="ViewBag.Accounts" class="form-control">
            <option value="">— Select account —</option>
        </select>
        <span asp-validation-for="AccountId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
            <option value="">— Select category —</option>
        </select>
        <span asp-validation-for="CategoryId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Amount"></label>
        <input type="text" id="Amount" name="Amount" value="" class="form-control" />
        <small>Always enter a positive amount. Income vs. expense is determined by the selected category.</small>
        <span asp-validation-for="Amount" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="BudgetId"></label>
        <select asp-for="BudgetId" asp-items="ViewBag.Budgets" class="form-control">
            <option value="">— None —</option>
        </select>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Record Transaction</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
