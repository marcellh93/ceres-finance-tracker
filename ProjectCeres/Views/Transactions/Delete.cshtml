@model Transaction
@{ ViewData["Title"] = "Delete Transaction"; }

<h1>Delete this transaction?</h1>
<p><strong>@(Model.Description ?? Model.Category.Name)</strong> — @Model.Date.ToString("dd/MM/yyyy") — @NumberFormatHelper.FormatAmount(Model.Amount, ViewData["NumberFormat"] as string)</p>
<p>This cannot be undone.</p>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
