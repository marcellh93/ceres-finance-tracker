@model TransactionEditViewModel
@{ ViewData["Title"] = "Delete Transaction"; }

<h1>Delete this @(Model.TransactionType == "LiabilityPayment" ? "liability payment" : "transaction")?</h1>

@if (Model.TransactionType == "LiabilityPayment")
{
    <p>
        <strong>@(Model.Description ?? "Liability Payment")</strong> —
        @Model.Date.ToString("dd/MM/yyyy") —
        @NumberFormatHelper.FormatAmount(Model.Amount, ViewData["NumberFormat"] as string)
    </p>
}
else
{
    <p>
        <strong>@(Model.Description ?? "Transaction")</strong> —
        @Model.Date.ToString("dd/MM/yyyy") —
        @NumberFormatHelper.FormatAmount(Model.Amount, ViewData["NumberFormat"] as string)
    </p>
}

<p>This cannot be undone.</p>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
