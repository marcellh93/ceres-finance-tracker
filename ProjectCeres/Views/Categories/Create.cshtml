@model CategoryCreateViewModel
@{ ViewData["Title"] = "New Category"; }

<h1>New Category</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryTypeId"></label>
        <select asp-for="CategoryTypeId" asp-items="ViewBag.CategoryTypes" class="form-control">
            <option value="">— Select type —</option>
        </select>
        <span asp-validation-for="CategoryTypeId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="LifestyleTag"></label>
        <select asp-for="LifestyleTag" asp-items="ViewBag.LifestyleTags" class="form-control"></select>
        <small>Used for 50/30/20 ratio budgeting in Phase 2. Optional for now.</small>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create Category</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
