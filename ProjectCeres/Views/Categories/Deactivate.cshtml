@model Category
@{ ViewData["Title"] = "Deactivate Category"; }

<h1>Deactivate "@Model.Name"?</h1>
<p>The category will be marked inactive. Existing transactions will not be affected.</p>

<form asp-action="Deactivate" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Yes, Deactivate</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
