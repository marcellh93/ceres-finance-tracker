@model IEnumerable<RecurringTransaction>
@{ ViewData["Title"] = "Recurring Reminders"; }

<div class="page-header">
    <h1>Recurring Reminders</h1>
    <div class="flex gap-2">
        <a asp-action="Upcoming" class="btn btn-secondary inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Upcoming Payments
        </a>
        <a asp-action="Create" class="btn btn-primary inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Reminder
        </a>
    </div>
</div>

@{
    var today = DateOnly.FromDateTime(DateTime.Today);
    var due   = Model.Where(r => r.IsActive && r.NextDueDate <= today).OrderBy(r => r.NextDueDate).ToList();
    var upcoming = Model.Where(r => r.IsActive && r.NextDueDate > today).OrderBy(r => r.NextDueDate).ToList();
    var inactive = Model.Where(r => !r.IsActive).OrderBy(r => r.Name).ToList();
}

@if (due.Any())
{
    <h2>Due Now</h2>
    @await Html.PartialAsync("_ReminderTable", due)
}

@if (upcoming.Any())
{
    <h2>Upcoming</h2>
    @await Html.PartialAsync("_ReminderTable", upcoming)
}

@if (inactive.Any())
{
    <h2>Inactive</h2>
    <table class="data-table">
        <thead>
            <tr><th>Name</th><th>Account</th><th>Category</th><th>Frequency</th></tr>
        </thead>
        <tbody>
            @foreach (var r in inactive)
            {
                <tr class="row-inactive">
                    <td>@r.Name</td>
                    <td>@r.Account.Name</td>
                    <td>@r.Category.Name</td>
                    <td>@r.Frequency</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!Model.Any())
{
    <p class="empty-state">No recurring reminders set up yet.</p>
}
