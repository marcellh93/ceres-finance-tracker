@model IEnumerable<RecurringTransaction>
<table class="data-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Account</th>
            <th>Category</th>
            <th>Est. Amount</th>
            <th>Frequency</th>
            <th>Next Due</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Name</td>
                <td>@r.Account.Name</td>
                <td>@r.Category.Name</td>
                <td>@NumberFormatHelper.FormatAmount(r.EstimatedAmount, ViewData["NumberFormat"] as string)</td>
                <td>@r.Frequency</td>
                <td>@r.NextDueDate.ToString("dd/MM/yyyy")</td>
                <td class="actions">
                    <a asp-action="Confirm" asp-route-id="@r.Id">Confirm</a>
                    <a asp-action="Dismiss" asp-route-id="@r.Id">Dismiss</a>
                    <a asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                    <a asp-action="Deactivate" asp-route-id="@r.Id" class="link-danger">Deactivate</a>
                </td>
            </tr>
        }
    </tbody>
</table>
