@model RecurringTransaction
@{ ViewData["Title"] = "Deactivate Reminder"; }

<h1>Deactivate "@Model.Name"?</h1>
<p>The reminder will be marked inactive and will no longer appear in your due list.</p>

<form asp-action="Deactivate" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Yes, Deactivate</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
