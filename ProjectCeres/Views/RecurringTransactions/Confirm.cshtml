@model TransactionCreateViewModel
@{
    ViewData["Title"] = "Confirm Reminder";
    var reminder = ViewBag.Reminder as RecurringTransaction;
}

<h1>Confirm: @reminder?.Name</h1>
<p class="form-hint">Review and adjust the details before recording this transaction.</p>

<form asp-action="Confirm" asp-route-id="@reminder?.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <input type="hidden" asp-for="AccountId" />
    <input type="hidden" asp-for="CategoryId" />
    <input type="hidden" asp-for="TransactionType" />

    <div class="form-group">
        <label asp-for="Date"></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Amount"></label>
        <input type="text" id="Amount" name="Amount"
               value="@NumberFormatHelper.FormatInputValue(Model.Amount, ViewData["NumberFormat"] as string)"
               class="form-control" />
        <span asp-validation-for="Amount" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" placeholder="@reminder?.Name" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Confirm &amp; Record</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
