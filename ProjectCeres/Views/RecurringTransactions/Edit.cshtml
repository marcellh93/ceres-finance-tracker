@model RecurringTransactionEditViewModel
@{ ViewData["Title"] = "Edit Reminder"; }

<h1>Edit Reminder</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="AccountId"></label>
        <select asp-for="AccountId" asp-items="ViewBag.Accounts" class="form-control"></select>
        <span asp-validation-for="AccountId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control"></select>
        <span asp-validation-for="CategoryId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="EstimatedAmount"></label>
        <input type="text" id="EstimatedAmount" name="EstimatedAmount"
               value="@NumberFormatHelper.FormatInputValue(Model.EstimatedAmount, ViewData["NumberFormat"] as string)"
               class="form-control" />
        <span asp-validation-for="EstimatedAmount" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Frequency"></label>
        <select asp-for="Frequency" asp-items="ViewBag.Frequencies" class="form-control"></select>
        <span asp-validation-for="Frequency" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ReminderBehaviour"></label>
        <select asp-for="ReminderBehaviour" asp-items="ViewBag.ReminderBehaviours" class="form-control" id="ReminderBehaviour"></select>
        <span asp-validation-for="ReminderBehaviour" class="field-error"></span>
    </div>

    <div class="form-group" id="DayOfPeriodGroup">
        <label asp-for="DayOfPeriod"></label>
        <input asp-for="DayOfPeriod" type="number" min="1" max="31" class="form-control" />
        <span asp-validation-for="DayOfPeriod" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="NextDueDate"></label>
        <input asp-for="NextDueDate" type="date" class="form-control" />
        <span asp-validation-for="NextDueDate" class="field-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            var sel = document.getElementById('ReminderBehaviour');
            var grp = document.getElementById('DayOfPeriodGroup');
            function toggle() { grp.style.display = sel.value === 'ManualDate' ? 'none' : ''; }
            sel.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
