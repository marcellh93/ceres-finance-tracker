@using ProjectCeres.ViewModels
@model IEnumerable<MovementListItemViewModel>
@{ ViewData["Title"] = "Movements"; }

<div class="page-header">
    <h1>Movements</h1>
</div>

<form asp-action="Index" method="get" class="filter-bar">
    <select name="accountId" class="form-control">
        <option value="">All Accounts</option>
        @foreach (var item in (SelectList)ViewBag.Accounts)
        {
            <option value="@item.Value" selected="@(item.Value == ViewBag.AccountId?.ToString())">@item.Text</option>
        }
    </select>
    <input type="date" name="from" value="@ViewBag.From" class="form-control" />
    <input type="date" name="to" value="@ViewBag.To" class="form-control" />
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a asp-action="Index" class="btn btn-link">Clear</a>
</form>

@if (!Model.Any())
{
    <p class="empty-state">No movements found.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Account(s)</th>
                <th>Category / Details</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Date.ToString("dd/MM/yyyy")</td>

                    @if (item.MovementType == MovementType.Transaction)
                    {
                        <td><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-blue-100 text-blue-800">Transaction</span></td>
                        <td>@item.AccountName</td>
                        <td>@item.CategoryName</td>
                        <td>@(item.Description ?? "—")</td>
                        <td class="@(item.CategoryTypeName == "Income" ? "amount-income" : "amount-expense") whitespace-nowrap">
                            @item.CurrencySymbol @NumberFormatHelper.FormatAmount(item.Amount, ViewData["NumberFormat"] as string)
                        </td>
                    }
                    else if (item.MovementType == MovementType.Transfer)
                    {
                        <td><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-purple-100 text-purple-800">Transfer</span></td>
                        <td>@item.SourceAccountName → @item.DestAccountName</td>
                        <td>—</td>
                        <td>@(item.Description ?? "—")</td>
                        <td class="amount-neutral whitespace-nowrap">@item.CurrencySymbol @NumberFormatHelper.FormatAmount(item.Amount, ViewData["NumberFormat"] as string)</td>
                    }
                    else
                    {
                        <td><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-orange-100 text-orange-800">Liability Payment</span></td>
                        <td>@item.AssetAccountName → @item.LiabilityAccountName</td>
                        <td>—</td>
                        <td>@(item.Description ?? "—")</td>
                        <td class="amount-neutral whitespace-nowrap">@NumberFormatHelper.FormatAmount(item.Amount, ViewData["NumberFormat"] as string)</td>
                    }

                    <td>
                        @if (item.MovementType != MovementType.LiabilityPayment)
                        {
                            var mvType = item.MovementType == MovementType.Transfer ? "transfer" : "transaction";
                            <div data-react="cleared-badge"
                                 data-id="@item.Id"
                                 data-movement-type="@mvType"
                                 data-cleared="@item.IsCleared.ToString().ToLower()"></div>
                        }
                        else
                        {
                            @if (item.IsCleared)
                            {
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-green-100 text-green-800">Cleared</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">Pending</span>
                            }
                        }
                    </td>

                    <td class="actions">
                        @if (item.MovementType == MovementType.Transaction)
                        {
                            <a asp-controller="Transactions" asp-action="Edit"
                               asp-route-id="@item.Id" asp-route-returnUrl="/Movements"
                               class="btn btn-sm btn-secondary inline-flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                Edit
                            </a>
                            <a asp-controller="Transactions" asp-action="Delete"
                               asp-route-id="@item.Id" asp-route-returnUrl="/Movements"
                               class="btn btn-sm btn-danger inline-flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                Delete
                            </a>
                        }
                        else if (item.MovementType == MovementType.Transfer)
                        {
                            <a asp-controller="Transfers" asp-action="Edit"
                               asp-route-id="@item.Id" asp-route-returnUrl="/Movements"
                               class="btn btn-sm btn-secondary inline-flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                Edit
                            </a>
                            <a asp-controller="Transfers" asp-action="Delete"
                               asp-route-id="@item.Id" asp-route-returnUrl="/Movements"
                               class="btn btn-sm btn-danger inline-flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                Delete
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Transactions" asp-action="Edit"
                               asp-route-id="@item.Id" asp-route-returnUrl="/Movements"
                               class="btn btn-sm btn-secondary inline-flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                Edit
                            </a>
                            <a asp-controller="Transactions" asp-action="Delete"
                               asp-route-id="@item.Id" asp-route-returnUrl="/Movements"
                               class="btn btn-sm btn-danger inline-flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                Delete
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="pagination">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-accountId="@ViewBag.AccountId"
                   asp-route-from="@ViewBag.From"
                   asp-route-to="@ViewBag.To"
                   class="@(i == (int)ViewBag.Page ? "page-link active" : "page-link")">@i</a>
            }
        </div>
    }
}
