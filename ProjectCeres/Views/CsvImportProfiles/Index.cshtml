@model IEnumerable<CsvImportProfileViewModel>
@using ProjectCeres.ViewModels
@{ ViewData["Title"] = "Import Profiles"; }

<div class="page-header">
    <h1>Import Profiles</h1>
    <a asp-action="Create" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Profile
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.Any())
{
    <p class="empty-state">No import profiles yet. Create one to map CSV columns to transaction fields.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Date Column</th>
                <th>Amount Column</th>
                <th>Description Column</th>
                <th>Category Column</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in Model)
            {
                <tr>
                    <td>@profile.Name</td>
                    <td>@profile.Mappings.DateColumn</td>
                    <td>@profile.Mappings.AmountColumn</td>
                    <td>@profile.Mappings.DescriptionColumn</td>
                    <td>@(profile.Mappings.CategoryColumn ?? "—")</td>
                    <td class="actions">
                        <a asp-action="Edit" asp-route-id="@profile.Id">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@profile.Id">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@{
    var deleted = ViewBag.DeletedProfiles as IEnumerable<CsvImportProfileViewModel>;
}
@if (deleted != null && deleted.Any())
{
    <h2 class="mt-6">Recently Deleted</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Recoverable for</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in deleted)
            {
                <tr class="row-inactive">
                    <td>@profile.Name</td>
                    <td>@profile.DaysUntilPurge more day(s)</td>
                    <td class="actions">
                        <form asp-action="Recover" asp-route-id="@profile.Id" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-link">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
                                Recover
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
