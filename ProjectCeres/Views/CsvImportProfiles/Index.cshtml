@model IEnumerable<ImportProfileViewModel>
@using ProjectCeres.ViewModels
@{ ViewData["Title"] = "Import Profiles"; }

<div class="page-header">
    <h1>Import Profiles</h1>
    <a asp-action="Create" class="btn btn-primary inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Profile
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.Any())
{
    <p class="empty-state">No import profiles yet. Create one to map CSV columns to transaction fields.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Date Column</th>
                <th>Amount Column</th>
                <th>Description Column</th>
                <th>Category Column</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in Model)
            {
                <tr>
                    <td>@profile.Name</td>
                    <td>@profile.Mappings.DateColumn</td>
                    <td>@profile.Mappings.AmountColumn</td>
                    <td>@profile.Mappings.DescriptionColumn</td>
                    <td>@(profile.Mappings.CategoryColumn ?? "—")</td>
                    <td class="actions">
                        <div class="flex gap-2 items-center">
                            <a asp-action="Edit" asp-route-id="@profile.Id" class="btn btn-sm btn-warning gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@profile.Id" class="btn btn-sm btn-danger gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@{
    var deleted = ViewBag.DeletedProfiles as IEnumerable<ImportProfileViewModel>;
}
@if (deleted != null && deleted.Any())
{
    <h2 class="mt-6">Recently Deleted</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Recoverable for</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in deleted)
            {
                <tr class="row-inactive">
                    <td>@profile.Name</td>
                    <td>Recoverable for @profile.DaysUntilPurge more day(s)</td>
                    <td class="actions">
                        <div class="flex gap-2 items-center">
                            <form asp-action="Recover" asp-route-id="@profile.Id" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-secondary gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                                    Recover
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
