@model ImportProfileEditViewModel
@{ ViewData["Title"] = "Edit Import Profile"; }

<div class="page-header">
    <h1>Edit Import Profile</h1>
</div>

<form asp-action="Edit" method="post" class="form-standard">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="form-group">
        <label asp-for="Name">Profile Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <fieldset>
        <legend>Column Mappings</legend>
        <p class="form-hint">Enter the exact column headers as they appear in your CSV file.</p>

        <div class="form-group">
            <label asp-for="Mappings.DateColumn">Date Column</label>
            <input asp-for="Mappings.DateColumn" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Mappings.AmountColumn">Amount Column</label>
            <input asp-for="Mappings.AmountColumn" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Mappings.DescriptionColumn">Description Column</label>
            <input asp-for="Mappings.DescriptionColumn" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Mappings.CategoryColumn">Category Column <span class="form-optional">(optional)</span></label>
            <input asp-for="Mappings.CategoryColumn" class="form-control" />
        </div>

        <div class="form-group form-check">
            <input asp-for="Mappings.FlipDebitSign" class="form-check-input" type="checkbox" />
            <label asp-for="Mappings.FlipDebitSign">Flip debit sign (negate negative debit amounts to positive)</label>
        </div>
    </fieldset>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><polyline points="20 6 9 17 4 12"/></svg>
            Save Changes
        </button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
