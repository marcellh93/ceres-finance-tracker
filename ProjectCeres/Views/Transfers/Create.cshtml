@model TransferCreateViewModel
@{ ViewData["Title"] = "New Transfer"; }

<h1>New Transfer</h1>
<p class="form-hint">Source and destination accounts must share the same currency.</p>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="Date"></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="SourceAccountId"></label>
        <select asp-for="SourceAccountId" asp-items="ViewBag.SourceAccounts" class="form-control">
            <option value="">— Select source account —</option>
        </select>
        <span asp-validation-for="SourceAccountId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="DestAccountId"></label>
        <select asp-for="DestAccountId" asp-items="ViewBag.DestAccounts" class="form-control">
            <option value="">— Select destination account —</option>
        </select>
        <span asp-validation-for="DestAccountId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Amount"></label>
        <input type="text" id="Amount" name="Amount" value="" class="form-control" />
        <span asp-validation-for="Amount" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="field-error"></span>
    </div>

    <div class="form-group">
        @{ ViewData["InputName"] = "Attachments"; }
        @await Html.PartialAsync("_AttachmentWidget")
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Record Transfer</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
