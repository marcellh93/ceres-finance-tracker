@model Transfer
@{ ViewData["Title"] = "Delete Transfer"; }

<h1>Delete this transfer?</h1>
<p><strong>@Model.SourceAccount.Name → @Model.DestAccount.Name</strong> — @Model.Date.ToString("dd/MM/yyyy") — @NumberFormatHelper.FormatAmount(Model.Amount, ViewData["NumberFormat"] as string)</p>
<p>This cannot be undone.</p>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="@(string.IsNullOrEmpty(ViewBag.ReturnUrl as string) ? Url.Action("Index") : ViewBag.ReturnUrl)" class="btn btn-secondary">Cancel</a>
</form>
