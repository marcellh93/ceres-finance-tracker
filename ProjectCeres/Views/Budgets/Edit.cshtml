@model CategoryBudgetEditViewModel
@{ ViewData["Title"] = "Edit Category Budget"; }

<h1>Edit Category Budget</h1>

<p>
    <strong>Category:</strong> @ViewBag.CategoryName &nbsp;
    <strong>Currency:</strong> @ViewBag.CurrencyCode
</p>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="LimitAmount"></label>
        <input asp-for="LimitAmount" class="form-control" />
        <span asp-validation-for="LimitAmount" class="field-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
