@model IEnumerable<CategoryBudget>
@{ ViewData["Title"] = "Category Budgets"; }

<div class="page-header">
    <h1>Category Budgets</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Category Budget</a>
</div>

@if (!Model.Any())
{
    <p class="empty-state">No category budgets defined.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Category</th>
                <th>Currency</th>
                <th>Monthly Limit</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var budget in Model.OrderBy(b => b.Category.Name))
            {
                <tr class="@(budget.IsActive ? "" : "row-inactive")">
                    <td>@budget.Category.Name</td>
                    <td>@budget.Currency.Code</td>
                    <td>@budget.LimitAmount.ToString("N2")</td>
                    <td>@(budget.IsActive ? "Active" : "Inactive")</td>
                    <td class="actions">
                        @if (budget.IsActive)
                        {
                            <a asp-action="Edit" asp-route-id="@budget.Id">Edit</a>
                            <a asp-action="Deactivate" asp-route-id="@budget.Id">Deactivate</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="page-section-link">
    <a asp-action="Goals">View Goal Budgets →</a>
</div>
