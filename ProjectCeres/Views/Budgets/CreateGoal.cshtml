@model BudgetCreateViewModel
@{ ViewData["Title"] = "New Goal Budget"; }

<div class="page-header">
    <h1>New Goal Budget</h1>
</div>

<div class="dashboard-card max-w-lg">
    <form asp-action="CreateGoal" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-error mb-4"></div>

        <div class="form-group">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="GoalType" class="form-label">Goal Type</label>
            <select asp-for="GoalType" asp-items="ViewBag.GoalTypes" class="form-control" id="GoalTypeSelect"></select>
            <span asp-validation-for="GoalType" class="field-error"></span>
        </div>

        <div class="form-group" id="LinkedAccountGroup">
            <label asp-for="LinkedAccountId" class="form-label">Linked Account</label>
            <select asp-for="LinkedAccountId" asp-items="ViewBag.AssetAccounts" class="form-control">
                <option value="">— Select account —</option>
            </select>
            <small class="text-muted-foreground text-xs mt-1 block">The balance of this account will be used to track progress toward the target.</small>
            <span asp-validation-for="LinkedAccountId" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="TargetAmount" class="form-label">Target Amount</label>
            <input asp-for="TargetAmount" class="form-control" />
            <span asp-validation-for="TargetAmount" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="CurrencyId" class="form-label">Currency</label>
            <select asp-for="CurrencyId" asp-items="ViewBag.Currencies" class="form-control">
                <option value="">— Select currency —</option>
            </select>
            <span asp-validation-for="CurrencyId" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="StartDate" class="form-label">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="EndDate" class="form-label">End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <small class="text-muted-foreground text-xs mt-1 block">Optional — leave blank for an open-ended goal.</small>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary inline-flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Create Goal
            </button>
            <a asp-action="Goals" class="btn btn-secondary inline-flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            const select = document.getElementById('GoalTypeSelect');
            const linkedGroup = document.getElementById('LinkedAccountGroup');
            function toggle() {
                linkedGroup.style.display = select.value === 'Savings' ? '' : 'none';
            }
            select.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
