@model BudgetEditViewModel
@{ ViewData["Title"] = "Edit Goal Budget"; }

<h1>Edit Goal Budget</h1>

<form asp-action="EditGoal" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="GoalType"></label>
        <select asp-for="GoalType" asp-items="ViewBag.GoalTypes" class="form-control" id="GoalTypeSelect"></select>
        <span asp-validation-for="GoalType" class="field-error"></span>
    </div>

    <div class="form-group" id="LinkedAccountGroup">
        <label asp-for="LinkedAccountId"></label>
        <select asp-for="LinkedAccountId" asp-items="ViewBag.AssetAccounts" class="form-control">
            <option value="">— Select account —</option>
        </select>
        <small>The balance of this account will be used to track progress toward the target.</small>
        <span asp-validation-for="LinkedAccountId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="TargetAmount"></label>
        <input asp-for="TargetAmount" class="form-control" />
        <span asp-validation-for="TargetAmount" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CurrencyId"></label>
        <select asp-for="CurrencyId" asp-items="ViewBag.Currencies" class="form-control">
            <option value="">— Select currency —</option>
        </select>
        <span asp-validation-for="CurrencyId" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <small>Optional — leave blank for an open-ended goal.</small>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Goals" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            const select = document.getElementById('GoalTypeSelect');
            const linkedGroup = document.getElementById('LinkedAccountGroup');
            function toggle() {
                linkedGroup.style.display = select.value === 'Savings' ? '' : 'none';
            }
            select.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
