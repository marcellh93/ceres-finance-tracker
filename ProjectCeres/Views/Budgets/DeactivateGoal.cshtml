@model Budget
@{ ViewData["Title"] = "Deactivate Goal Budget"; }

<div class="page-header">
    <h1>Deactivate Goal Budget</h1>
</div>

<div class="dashboard-card max-w-md">
    <div class="mb-4">
        <p class="text-base font-medium">Deactivate "@Model.Name"?</p>
        <p class="text-sm text-muted-foreground mt-1">The goal budget will be marked inactive. Existing tagged transactions will not be affected.</p>
    </div>

    <form asp-action="DeactivateGoal" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger inline-flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
                Yes, Deactivate
            </button>
            <a asp-action="Goals" class="btn btn-secondary inline-flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Cancel
            </a>
        </div>
    </form>
</div>
