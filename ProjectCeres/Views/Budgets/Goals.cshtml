@model IEnumerable<Budget>
@{ ViewData["Title"] = "Goal Budgets"; }

<div class="page-header">
    <h1>Goal Budgets</h1>
    <a asp-action="CreateGoal" class="btn btn-primary">+ New Goal Budget</a>
</div>

@if (!Model.Any())
{
    <p class="empty-state">No goal budgets defined.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Target</th>
                <th>Currency</th>
                <th>Start</th>
                <th>End</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var goal in Model.OrderByDescending(g => g.StartDate))
            {
                <tr class="@(goal.IsActive ? "" : "row-inactive")">
                    <td>@goal.Name</td>
                    <td>@goal.GoalType</td>
                    <td>@goal.TargetAmount.ToString("N2")</td>
                    <td>@goal.Currency.Code</td>
                    <td>@goal.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@(goal.EndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td>@(goal.IsActive ? "Active" : "Inactive")</td>
                    <td class="actions">
                        @if (goal.IsActive)
                        {
                            <a asp-action="EditGoal" asp-route-id="@goal.Id">Edit</a>
                            <a asp-action="DeactivateGoal" asp-route-id="@goal.Id">Deactivate</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="page-section-link">
    <a asp-action="Index">← Category Budgets</a>
</div>
