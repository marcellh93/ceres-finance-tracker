@model SettingsEditViewModel
@{ ViewData["Title"] = "Settings"; }

<h1>Settings</h1>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="NumberFormat"></label>
        <select asp-for="NumberFormat" asp-items="ViewBag.NumberFormats" class="form-control"></select>
        <span asp-validation-for="NumberFormat" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateFormat"></label>
        <select asp-for="DateFormat" asp-items="ViewBag.DateFormats" class="form-control"></select>
        <span asp-validation-for="DateFormat" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="DefaultCurrencyId"></label>
        <select asp-for="DefaultCurrencyId" asp-items="ViewBag.Currencies" class="form-control"></select>
        <span asp-validation-for="DefaultCurrencyId" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Save Settings
    </button>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
