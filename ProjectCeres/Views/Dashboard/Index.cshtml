@model DashboardData
@{ ViewData["Title"] = "Dashboard"; }
<div id="react-root"></div>

<h1>Dashboard</h1>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

    <section class="dashboard-card col-span-1 lg:col-span-2">
        <h2>Net Worth</h2>
        @if (!Model.NetWorth.Any())
        {
            <p class="empty-state">No accounts yet.</p>
        }
        else
        {
            <table class="summary-table">
                <thead>
                    <tr><th>Currency</th><th>Assets</th><th>Liabilities</th><th>Net Worth</th></tr>
                </thead>
                <tbody>
                    @foreach (var nw in Model.NetWorth)
                    {
                        <tr>
                            <td>@nw.CurrencyCode</td>
                            <td class="amount-mono">@NumberFormatHelper.FormatAmount(nw.Assets, ViewData["NumberFormat"] as string)</td>
                            <td class="amount-mono">@NumberFormatHelper.FormatAmount(nw.Liabilities, ViewData["NumberFormat"] as string)</td>
                            <td class="@(nw.NetWorth >= 0 ? "amount-income" : "amount-expense") whitespace-nowrap">
                                @nw.CurrencySymbol @NumberFormatHelper.FormatAmount(nw.NetWorth, ViewData["NumberFormat"] as string)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="dashboard-card">
        <h2>Month to Date — @Model.CurrencyCode</h2>
        <dl class="stat-list">
            <dt>Income</dt>
            <dd class="amount-income">@Model.CurrencySymbol @NumberFormatHelper.FormatAmount(Model.MtdIncome, ViewData["NumberFormat"] as string)</dd>

            <dt>Expenses</dt>
            <dd class="amount-expense">@Model.CurrencySymbol @NumberFormatHelper.FormatAmount(Model.MtdExpenses, ViewData["NumberFormat"] as string)</dd>

            <dt>Savings Rate</dt>
            <dd>@(Model.SavingsRate.ToString("P1"))</dd>
        </dl>
    </section>

    <section class="dashboard-card">
        <h2>Reminders</h2>
        @if (Model.PendingRemindersCount == 0)
        {
            <p>No reminders due.</p>
        }
        else
        {
            <p class="alert alert-warning">
                <strong>@Model.PendingRemindersCount</strong> reminder@(Model.PendingRemindersCount == 1 ? "" : "s") due.
                <a asp-controller="RecurringTransactions" asp-action="Index">Review</a>
            </p>
        }
    </section>

</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div data-react="category-budget-bars"></div>
    <div data-react="goal-budget-bars"></div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div data-react="net-worth-chart"></div>
    <div data-react="income-expense-chart"></div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div data-react="spending-donut-chart"></div>
    <div data-react="account-balances-chart"></div>
    <div data-react="cash-flow-chart"></div>
</div>

<div class="dashboard-actions">
    <a asp-controller="Transactions" asp-action="Create" class="btn btn-primary">+ Record Transaction</a>
    <a asp-controller="Transfers" asp-action="Create" class="btn btn-secondary">+ Record Transfer</a>
    <a asp-controller="Reports" asp-action="Index" class="btn btn-secondary">View Reports</a>
</div>
