@model IReadOnlyList<NetWorthEntry>
@{ ViewData["Title"] = "Net Worth Statement"; }

<div class="page-header">
    <h1>Net Worth Statement</h1>
    <a asp-action="ExportNetWorth" class="btn btn-secondary inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export CSV
    </a>
</div>

@if (!Model.Any())
{
    <p class="empty-state">No accounts found.</p>
}
else
{
    @foreach (var entry in Model)
    {
        <h2>@entry.CurrencyCode</h2>
        <table class="summary-table">
            <tr><th>Assets</th><td class="amount-income">@entry.CurrencySymbol @NumberFormatHelper.FormatAmount(entry.Assets, ViewData["NumberFormat"] as string)</td></tr>
            <tr><th>Liabilities</th><td class="amount-expense">@entry.CurrencySymbol @NumberFormatHelper.FormatAmount(entry.Liabilities, ViewData["NumberFormat"] as string)</td></tr>
            <tr class="total-row">
                <th>Net Worth</th>
                <td class="@(entry.NetWorth >= 0 ? "amount-income" : "amount-expense")">
                    @entry.CurrencySymbol @NumberFormatHelper.FormatAmount(entry.NetWorth, ViewData["NumberFormat"] as string)
                </td>
            </tr>
        </table>
    }
}

<a asp-action="Index" class="btn btn-secondary">← Reports</a>
