@model List<MonthlyCashFlowRow>
@{ ViewData["Title"] = "Monthly Cash Flow"; }

<div class="page-header">
    <h1>Monthly Cash Flow Trend</h1>
    <a asp-action="ExportMonthlyCashFlow"
       asp-route-currencyId="@ViewBag.SelectedCurrencyId"
       asp-route-from="@ViewBag.From"
       asp-route-to="@ViewBag.To"
       class="btn btn-secondary inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export CSV
    </a>
</div>

<form asp-action="MonthlyCashFlow" method="get" class="filter-bar">
    <div class="form-group mb-0">
        <label for="currencyId">Currency</label>
        <select id="currencyId" name="currencyId" asp-items="ViewBag.Currencies" class="form-control w-auto"></select>
    </div>
    <div class="form-group mb-0">
        <label for="from">From</label>
        <input id="from" type="date" name="from" value="@ViewBag.From" class="form-control w-auto" />
    </div>
    <div class="form-group mb-0">
        <label for="to">To</label>
        <input id="to" type="date" name="to" value="@ViewBag.To" class="form-control w-auto" />
    </div>
    <div class="form-group mb-0 self-end">
        <button type="submit" class="btn btn-secondary">Apply</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="dashboard-card text-center py-12">
        <p class="text-gray-400 text-sm">No transactions in this period.</p>
    </div>
}
else
{
    var fmt = ViewData["NumberFormat"] as string;
    var sym = Model.First().CurrencySymbol;
    <div class="dashboard-card p-0 overflow-hidden">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Month</th>
                    <th class="text-right">Income</th>
                    <th class="text-right">Expenses</th>
                    <th class="text-right">Net</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var net = row.Net;
                    <tr>
                        <td class="font-medium">@(new DateTime(row.Year, row.Month, 1).ToString("MMM yyyy"))</td>
                        <td class="text-right amount-income tabular-nums">@sym @NumberFormatHelper.FormatAmount(row.TotalIncome, fmt)</td>
                        <td class="text-right amount-expense tabular-nums">@sym @NumberFormatHelper.FormatAmount(row.TotalExpenses, fmt)</td>
                        <td class="text-right tabular-nums @(net >= 0 ? "amount-income" : "amount-expense")">@sym @NumberFormatHelper.FormatAmount(net, fmt)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <td class="font-semibold">Total</td>
                    <td class="text-right amount-income tabular-nums font-semibold">@sym @NumberFormatHelper.FormatAmount(Model.Sum(r => r.TotalIncome), fmt)</td>
                    <td class="text-right amount-expense tabular-nums font-semibold">@sym @NumberFormatHelper.FormatAmount(Model.Sum(r => r.TotalExpenses), fmt)</td>
                    @{ var totalNet = Model.Sum(r => r.Net); }
                    <td class="text-right tabular-nums font-semibold @(totalNet >= 0 ? "amount-income" : "amount-expense")">@sym @NumberFormatHelper.FormatAmount(totalNet, fmt)</td>
                </tr>
            </tfoot>
        </table>
    </div>
}

<div class="mt-6">
    <a asp-action="Index" class="btn btn-secondary">← Reports</a>
</div>
