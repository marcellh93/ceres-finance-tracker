@model ExpenseBreakdown
@{ ViewData["Title"] = "Expense Breakdown"; }

<h1>Expense Breakdown by Category</h1>

<form asp-action="ExpenseBreakdown" method="get" class="filter-bar">
    <select name="currencyId" asp-items="ViewBag.Currencies" class="form-control"></select>
    <input type="date" name="from" value="@ViewBag.From" class="form-control" />
    <input type="date" name="to"   value="@ViewBag.To"   class="form-control" />
    <button type="submit" class="btn btn-secondary">Apply</button>
</form>

@if (!Model.Categories.Any())
{
    <p class="empty-state">No expenses in this period.</p>
}
else
{
    var total = Model.Categories.Sum(c => c.Total);
    <table class="data-table">
        <thead>
            <tr><th>Category</th><th>Lifestyle Tag</th><th>Amount</th><th>% of Total</th></tr>
        </thead>
        <tbody>
            @foreach (var cat in Model.Categories)
            {
                <tr>
                    <td>@cat.CategoryName</td>
                    <td>@(cat.LifestyleTag ?? "—")</td>
                    <td>@Model.CurrencySymbol @NumberFormatHelper.FormatAmount(cat.Total, ViewData["NumberFormat"] as string)</td>
                    <td>@((total > 0 ? cat.Total / total : 0).ToString("P1"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="total-row">
                <td colspan="2"><strong>Total</strong></td>
                <td><strong>@Model.CurrencySymbol @NumberFormatHelper.FormatAmount(total, ViewData["NumberFormat"] as string)</strong></td>
                <td></td>
            </tr>
        </tfoot>
    </table>
}

<a asp-action="Index" class="btn btn-secondary">← Reports</a>
