@model List<LargestExpenseRow>
@{ ViewData["Title"] = "Largest Expenses"; }

<div class="page-header">
    <h1>Largest Expenses</h1>
    <a asp-action="ExportLargestExpenses"
       asp-route-currencyId="@ViewBag.SelectedCurrencyId"
       asp-route-from="@ViewBag.From"
       asp-route-to="@ViewBag.To"
       asp-route-limit="@ViewBag.Limit"
       class="btn btn-secondary inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export CSV
    </a>
</div>

<form asp-action="LargestExpenses" method="get" class="filter-bar">
    <div class="form-group mb-0">
        <label for="currencyId">Currency</label>
        <select id="currencyId" name="currencyId" asp-items="ViewBag.Currencies" class="form-control w-auto"></select>
    </div>
    <div class="form-group mb-0">
        <label for="from">From</label>
        <input id="from" type="date" name="from" value="@ViewBag.From" class="form-control w-auto" />
    </div>
    <div class="form-group mb-0">
        <label for="to">To</label>
        <input id="to" type="date" name="to" value="@ViewBag.To" class="form-control w-auto" />
    </div>
    <div class="form-group mb-0">
        <label for="limit">Show top</label>
        <select id="limit" name="limit" class="form-control w-auto">
            @foreach (var n in new[] { 10, 25, 50, 100 })
            {
                <option value="@n" selected="@(ViewBag.Limit == n ? "selected" : null)">@n</option>
            }
        </select>
    </div>
    <div class="form-group mb-0 self-end">
        <button type="submit" class="btn btn-secondary">Apply</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="dashboard-card text-center py-12">
        <p class="text-gray-400 text-sm">No expenses in this period.</p>
    </div>
}
else
{
    <div class="dashboard-card p-0 overflow-hidden">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Account</th>
                    <th class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="text-gray-500 tabular-nums">@row.Date.ToString("yyyy-MM-dd")</td>
                        <td class="font-medium">@(string.IsNullOrEmpty(row.Description) ? "—" : row.Description)</td>
                        <td>@row.CategoryName</td>
                        <td>@row.AccountName</td>
                        <td class="text-right amount-expense tabular-nums">@row.CurrencySymbol @NumberFormatHelper.FormatAmount(row.Amount, ViewData["NumberFormat"] as string)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-6">
    <a asp-action="Index" class="btn btn-secondary">← Reports</a>
</div>
