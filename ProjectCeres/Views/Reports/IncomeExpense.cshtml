@model IncomeExpenseSummary
@{ ViewData["Title"] = "Income & Expense Summary"; }

<h1>Income &amp; Expense Summary</h1>

<form asp-action="IncomeExpense" method="get" class="filter-bar">
    <select name="currencyId" asp-items="ViewBag.Currencies" class="form-control"></select>
    <input type="date" name="from" value="@ViewBag.From" class="form-control" />
    <input type="date" name="to"   value="@ViewBag.To"   class="form-control" />
    <button type="submit" class="btn btn-secondary">Apply</button>
</form>

<table class="summary-table">
    <tr><th>Total Income</th><td class="amount-income">@Model.CurrencySymbol @NumberFormatHelper.FormatAmount(Model.TotalIncome, ViewData["NumberFormat"] as string)</td></tr>
    <tr><th>Total Expenses</th><td class="amount-expense">@Model.CurrencySymbol @NumberFormatHelper.FormatAmount(Model.TotalExpenses, ViewData["NumberFormat"] as string)</td></tr>
    <tr><th>Net</th><td class="@(Model.TotalIncome - Model.TotalExpenses >= 0 ? "amount-income" : "amount-expense")">
        @Model.CurrencySymbol @NumberFormatHelper.FormatAmount(Model.TotalIncome - Model.TotalExpenses, ViewData["NumberFormat"] as string)
    </td></tr>
    <tr><th>Savings Rate</th><td>@Model.SavingsRate.ToString("P1")</td></tr>
</table>

<a asp-action="Index" class="btn btn-secondary">← Reports</a>
