{
  "ConnectionStrings": {
    "DefaultConnection": "configure-via-user-secrets"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Argon2id": {
      "MemorySizeKb": 19456,
      "Iterations": 2,
      "Parallelism": 1
    },
    "TokenLookupSecret": {
      "Secret": "configure-via-user-secrets"
    },
    "Cookie": {
      "SessionExpiryMinutes": 30,
      "PersistentExpiryDays": 30
    },
    "IpEnforcement": {
      "DefaultEnabled": false
    }
  }
}
