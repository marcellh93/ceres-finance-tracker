root = true

[*.cs]
# C# minimal defaults — matches existing implicit conventions
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8

# ─────────────────────────────────────────────────────────────────────────
# Stage 9.5c — Per-analyzer severity flip from warning to error
# (N+M+1, after 48h soak AND baseline drained per C-2; both verified 2026-05-30:
#  ~72h since N+2 commit 892cfe7, 0 real suppressions, 0 production CER violations)
# ─────────────────────────────────────────────────────────────────────────
dotnet_diagnostic.CER001.severity = error
dotnet_diagnostic.CER002.severity = error
dotnet_diagnostic.CER004.severity = error
dotnet_diagnostic.CER010.severity = error
# CER020 (resx parity) was already at error from day 1

# Stage 9.5f/9.5g — CER005/CER006 flip from warning to error (descriptors shipped
# 2026-06-09; ≥48h C-2 soak satisfied, 0 production violations re-verified 2026-06-13).
dotnet_diagnostic.CER005.severity = error
dotnet_diagnostic.CER006.severity = error

# ─────────────────────────────────────────────────────────────────────────
# Per-analyzer baseline-suppression sections (Stage 9.5c, per C-3)
# Each entry has a one-line reason. Suppressed lines drain to zero before
# the warning→error flip at N+M+1 per C-2.
# ─────────────────────────────────────────────────────────────────────────

# CER004 — Stage 9.5c baseline. Sites pending TimeProvider migration.
# Drain progress: grep -c 'dotnet_diagnostic.CER004' .editorconfig
# Baseline at N+2: 0 suppressed sites. Task 5 retro-decoration was complete.
# No per-file suppression entries required.

# Stage 9.1.6 — IDE0001 (redundant namespace prefix) promoted to warning.
# Tripwire is `dotnet format style --verify-no-changes --diagnostics IDE0001`
# (IDE0001 is a format/IDE-only analyzer — it does NOT surface at dotnet build).
dotnet_diagnostic.IDE0001.severity = warning
