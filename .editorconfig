root = true

[*.cs]
# C# minimal defaults — matches existing implicit conventions
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8

# ─────────────────────────────────────────────────────────────────────────
# Stage 9.5c — Per-analyzer severity flip from warning to error
# (N+M+1, after 48h soak AND baseline drained per C-2; both verified 2026-05-30:
#  ~72h since N+2 commit 892cfe7, 0 real suppressions, 0 production CER violations)
# ─────────────────────────────────────────────────────────────────────────
dotnet_diagnostic.CER001.severity = error
dotnet_diagnostic.CER002.severity = error
dotnet_diagnostic.CER004.severity = error
dotnet_diagnostic.CER010.severity = error
# CER020 (resx parity) was already at error from day 1

# Stage 9.5f/9.5g — CER005/CER006 flip from warning to error (descriptors shipped
# 2026-06-09; ≥48h C-2 soak satisfied, 0 production violations re-verified 2026-06-13).
dotnet_diagnostic.CER005.severity = error
dotnet_diagnostic.CER006.severity = error

# CER007 — controller must not call AppDbContext (ADR-0017). Suggestion, not
# error: 14 controllers still inject it (read-path projections plus the auth
# controllers). Raise to error once they are migrated. `dotnet build` does not
# print suggestions — to count, flip this line to `warning` and rebuild.
dotnet_diagnostic.CER007.severity = suggestion

# ─────────────────────────────────────────────────────────────────────────
# Per-analyzer baseline-suppression sections (Stage 9.5c, per C-3)
# Each entry has a one-line reason. Suppressed lines drain to zero before
# the warning→error flip at N+M+1 per C-2.
# ─────────────────────────────────────────────────────────────────────────

# CER004 — Stage 9.5c baseline. Sites pending TimeProvider migration.
# Drain progress: grep -c 'dotnet_diagnostic.CER004' .editorconfig
# Baseline at N+2: 0 suppressed sites. Task 5 retro-decoration was complete.
# No per-file suppression entries required.

# Stage 9.1.6 — IDE0001 (redundant namespace prefix) promoted to warning.
# Tripwire is `dotnet format style --verify-no-changes --diagnostics IDE0001`
# (IDE0001 is a format/IDE-only analyzer — it does NOT surface at dotnet build).
dotnet_diagnostic.IDE0001.severity = warning

# EF Core auto-generated migration files — never hand-edited.
[ProjectCeres/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1825.severity = none

# ─────────────────────────────────────────────────────────────────────────
# Test projects — three CA naming rules fire on deliberate test conventions
# (surfaced as CI annotations 2026-09-10). Scoped to test code only; the
# production analyzer rules stay at latest-recommended.
#   CA1707 (no underscores in type name): the CERnnn_ prefix maps a test class
#     to its analyzer rule id, and GroupN_ groups RLS scenarios — the
#     underscore is the convention, not an accident.
#   CA1711 (type must not end in 'Collection'): xUnit REQUIRES the suffix on
#     [CollectionDefinition] classes; renaming breaks the collection fixture.
#   CA1051 (no visible instance fields): shared test-base fixtures expose fields
#     to subclasses by design; encapsulation adds nothing in test-only code.
# ─────────────────────────────────────────────────────────────────────────
[{ProjectCeres.Tests,ProjectCeres.Analyzers.Tests}/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1051.severity = none
# CA1000 fires on the Microsoft.CodeAnalysis.Testing verifier idiom (static
# helpers on a generic CSharpAnalyzerVerifier<T> / CodeFixVerifier<T>) — the
# canonical pattern that harness ships. CA1859/CA1861 are perf micro-opts
# (concrete-over-interface, static-readonly-over-inline-array) with no value in
# test code, where using the interface type or an inline literal is the point.
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none
