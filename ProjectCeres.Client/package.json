  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm check-size",
    "lint": "eslint .",
    "lint:tests": "! grep -rE '^const mockFetch = vi\\.fn' src --include='*.test.tsx' --include='*.test.ts'",
    "preview": "vite preview",
    "test": "pnpm lint:tests && vitest run",
    "test:ci": "pnpm lint:tests && vitest run",
    "test:watch": "vitest",
    "check-size": "node scripts/check-bundle-size.mjs",
    "e2e": "playwright test --config e2e/playwright.golden.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.golden.config.ts --ui",
    "e2e:walk": "playwright test --config e2e/playwright.config.ts",
    "agent-walk": "tsx e2e/agent-walk.ts"
  },
